# Swastik: environment configuration
# Copy to .env.local for development. Never commit real values.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.
# With APP_STAGE=production the app refuses to start with unsafe values (src/server/env.ts).
# Full reference: docs/environment-variables.md

# --- Core -------------------------------------------------------------------
# development | preview | production. Defaults from NODE_ENV.
# "preview" = hosted demo: test payments only, a visible banner, not indexed by search engines.
APP_STAGE=
APP_URL=http://localhost:3000
# Use a pooled connection string on Vercel (Neon "pooled", Supabase "transaction" pooler).
DATABASE_URL=postgres://swastik:swastik@localhost:5432/swastik_dev
DATABASE_POOL_MAX=5
# 32+ random characters. Keys the hashes of admin sessions, reset links and order links.
#   openssl rand -base64 48
AUTH_SECRET=
# Bearer token Vercel Cron sends to /api/cron/maintenance. 32+ characters.
CRON_SECRET=
# Optional. Enables the one-time /admin/setup page while no administrator exists.
# Remove it after the administrator account is created.
ADMIN_SETUP_TOKEN=

# --- Email --------------------------------------------------------------------
# outbox: nothing is sent; emails are recorded and shown as "not sent" in the admin panel.
# smtp: delivered through any transactional provider's SMTP service.
EMAIL_DRIVER=outbox
EMAIL_FROM="Swastik <orders@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587) | implicit (port 465) | none (local testing only)
SMTP_TLS=starttls

# --- Image storage ------------------------------------------------------------
# local: files on disk (development only, Vercel has no persistent disk)
# database: images stored in PostgreSQL (fine for a small catalogue)
# s3: any S3-compatible bucket (Cloudflare R2, AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Payments -----------------------------------------------------------------
# none: no online payment. mock: built-in test gateway (refused when APP_STAGE=production).
# razorpay: Razorpay Standard Checkout. Test keys start with rzp_test_, live keys with rzp_live_.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=

# --- Sample data (scripts/seed-sample.ts) ----------------------------------------
# Adds an illustrative catalogue for development and previews. Refused in production.
SEED_SAMPLE_DATA=false
